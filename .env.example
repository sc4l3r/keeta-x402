# Log level for the facilitator (DEBUG, INFO, WARN, ERROR)
APP_LOG_LEVEL="INFO"

# Passphrase of the client (payer) Keeta account
CLIENT_PASSPHRASE=""

# Public key of the resource server Keeta account
# Required when testnet is in KEETA_NETWORKS (used by the demo /weather route)
SERVER_ADDRESS=""

# Passphrase of the facilitator (fee payer) Keeta account
FACILITATOR_PASSPHRASE=""

# URL of the facilitator (used by the standalone server app)
FACILITATOR_URL=http://localhost:4022

# HTTP port the facilitator listens on (default: 4022)
PORT=4022

# Number of fee-payer accounts derived from FACILITATOR_PASSPHRASE (default: 1)
# Each account must be funded separately on each enabled network.
FACILITATOR_AMOUNT_ACCOUNTS=1

# Comma-separated list of Keeta networks to enable (default: test,main)
# Valid values: test, main
KEETA_NETWORKS=test,main
