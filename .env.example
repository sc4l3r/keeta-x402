# Log level for the facilitator (DEBUG, INFO, WARN, ERROR)
APP_LOG_LEVEL="INFO"

# Passphrase of the client (payer) Keeta account
CLIENT_PASSPHRASE=""

# Public key of the resource server Keeta account
# Required when testnet is in KEETA_NETWORKS (used by the demo /weather route)
SERVER_ADDRESS=""

# Passphrase of the facilitator (fee payer) Keeta account
FACILITATOR_PASSPHRASE=""

# Comma-separated list of Keeta networks to enable (default: test,main)
# Valid values: test, main
KEETA_NETWORKS=test,main

# URL of the facilitator (used by the standalone server app)
FACILITATOR_URL=http://localhost:4022

# HTTP port the facilitator listens on (default: 4022)
PORT=4022

# Number of fee-payer accounts derived from FACILITATOR_PASSPHRASE (default: 1)
# Each account must be funded separately on each enabled network.
# FACILITATOR_AMOUNT_ACCOUNTS=1

# Minimum KTA balance a fee payer account must have to be enabled (default: 1)
# FACILITATOR_MIN_FEE_BALANCE_KTA=1

# KTA balance below which a fee payer is proactively refilled while still kept in
# rotation, so it ideally never drops below the minimum above (default: 2).
# Must be between FACILITATOR_MIN_FEE_BALANCE_KTA and FACILITATOR_REFILL_TARGET_KTA.
# FACILITATOR_REFILL_THRESHOLD_KTA=2

# Minimum KTA balance a fee payer account must be refilled to to be considered healthy again (default: 10)
# FACILITATOR_REFILL_TARGET_KTA=10

# Interval in ms to poll facilitator fee payer account balances and check for healthiness.
# FACILITATOR_POLL_INTERVAL_MS=30000

# Whether to enable the /metrics route for Prometheus metrics.
# Enabled by setting this to "true".
# FACILITATOR_METRICS_ENABLED=false

# Pre-shared token to require in the "Authorization: Bearer" header to access the /metrics route.
# If unset, the route is publically available.
# FACILITATOR_METRICS_TOKEN=""
