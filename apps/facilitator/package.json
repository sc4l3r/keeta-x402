{
  "name": "facilitator",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch src/main.ts\" \"vite\"",
    "build:server": "tsup src/main.ts --format esm --out-dir dist --target node22",
    "build:web": "vite build",
    "build": "pnpm build:server && pnpm build:web",
    "serve": "node dist/main.js"
  },
  "dependencies": {
    "@keetanetwork/anchor": "^0.0.78",
    "@keetanetwork/keetanet-client": "^0.18.2",
    "@x402/core": "^2.20.0",
    "@x402/express": "2.20.0",
    "@x402/keeta": "^2.20.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "lucide-preact": "^1.21.0",
    "preact": "^10.29.2",
    "prismjs": "^1.30.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@tailwindcss/vite": "^4.3.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/prismjs": "^1.26.6",
    "concurrently": "^10.0.3",
    "tailwindcss": "^4.3.1",
    "tsup": "^8.4.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
